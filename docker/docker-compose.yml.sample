services:
  ransomware-live:
    build:
      context: ..
      dockerfile: docker/Dockerfile
    container_name: ransomware-live
    volumes:
      - ./data/data:/ransomware.live/data
      - ./data/docs:/ransomware.live/docs
      - ./data/source:/ransomware.live/source
    env_file: .env
    ports:
      - "127.0.0.1:8080:8080"

  tor:
    restart: always
    image: dockage/tor-privoxy:latest